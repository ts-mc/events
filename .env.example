# TheySix Events website — environment
#
# This project needs no environment variables. Everything the site states about
# the Minecraft server is a checked constant in src/data/site.ts, which keeps
# those facts auditable and greppable.
#
# Nothing to copy into .env.local. This file documents that fact so the absence
# of configuration is not mistaken for an oversight.

# ---------------------------------------------------------------------------
# Optional: only needed to deploy behind a non-default canonical origin.
# Leave unset for the production site at events-theysix.ro-mihaiu.xyz.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://events-theysix.ro-mihaiu.xyz
